# Supabase プロジェクト設定 > Data API / API Keys から取得して .env.local にコピーする
# publishable key はブラウザに露出する前提のキー。RLS で守るため公開されて問題ない。
# secret key（sb_secret_...）は RLS を無視できるので絶対にここへ書かない。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GAS の共有シークレット（Vercel と同じ値を GAS のスクリプト プロパティにも入れる）
INGEST_SECRET=

# Supabase の secret key（sb_secret_...）。GAS はログインできないため、
# メール受信APIだけ RLS を越えてこのキーで書き込む。ブラウザには渡らない。
SUPABASE_SECRET_KEY=
